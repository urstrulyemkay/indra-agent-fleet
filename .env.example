# Anthropic API key — OPTIONAL. Only needed if you want to run an agent's
# Python CLI standalone (e.g. `python -m agents.job_hunter ...`). The
# Claude-Code-triggered path (user says "run job hunter" in a Claude Code
# session and the assistant does the work) does NOT need this key, because
# the LLM call happens through the user's existing Claude Code subscription.
# Leave blank unless you're wiring an unattended cron/launchd daemon.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-7
FLEET_DB_PATH=./data/status.db
OUTPUTS_DIR=./outputs
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# Dashboard authentication — OPTIONAL.
# Default behavior (both blank): dashboard is open, no login required.
# This is safe when Indra binds to 127.0.0.1 only (the default in DASHBOARD_HOST).
# Set both values to require HTTP Basic Auth — useful if you ever expose the
# dashboard publicly (Cloudflare Tunnel, VPS deploy, etc.).
# Generate a strong password: openssl rand -base64 32
INDRA_DASHBOARD_USER=
INDRA_DASHBOARD_PASSWORD=agent123$

# Langfuse — optional. Get keys at https://cloud.langfuse.com
# If unset, agents fall back to hardcoded prompts and skip tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# n8n Cloud integration (your existing instance at umcrazy.app.n8n.cloud)
N8N_API_BASE_URL=https://umcrazy.app.n8n.cloud/api/v1
N8N_API_KEY=
# After importing n8n workflows, paste the "Production URL" of the
# `indra · approve & send via Meta` workflow's webhook trigger here.
N8N_SEND_WEBHOOK_URL=

# Shared secret for HMAC verification of webhooks between Indra ↔ n8n.
# MUST be the same value in n8n Cloud's environment variables.
# Generate: openssl rand -hex 32
INDRA_N8N_SHARED_SECRET=

# Meta / Instagram credentials.
# These end up in the n8n workflow's static data automatically when you push
# the workflow (via `python -m core.n8n_deployer --push n8n-flows/...json`).
# Do NOT paste these in chat — only in this .env file.

# Step 3 of Meta App setup: click "Reset" next to App Secret in the Meta dev
# portal, then paste the new value here.
META_APP_SECRET=

# Random string used during webhook subscription verification.
# Pre-filled with one I generated for you — change anytime, just make sure
# you paste the same value in the Meta dev portal's webhook config.
META_VERIFY_TOKEN=

# Long-lived Page Access Token from Meta. Step 6 in setup: generate via
# Graph API Explorer, exchange for long-lived, paste here.
META_PAGE_ACCESS_TOKEN=

# Your IG Business / Creator account's numeric ID. Looks like 17841...
# Get via: Graph API Explorer → GET /me/accounts → drill into instagram_business_account
IG_BUSINESS_ACCOUNT_ID=

# GitHub PAT — REQUIRED when your daily-brief / thought-mechanic repos are private.
# The dashboard hits the GitHub Contents API to render brief archives + heatmaps.
# Easiest: `gh auth token` (uses your existing gh CLI token, 'repo' scope).
# Safer alternative: Fine-Grained PAT at github.com/settings/personal-access-tokens
#                    scoped to ONLY the relevant repo · Contents: Read-only
GITHUB_TOKEN=

# Resend — transactional email (free tier: 3K emails / month).
# Sign up at https://resend.com → API Keys → Create API Key → paste below.
# Used for fleet notifications. NEVER for cold email (Resend's AUP bans it).
RESEND_API_KEY=

# Apify — LinkedIn jobs scraper for the job_hunter agent.
# Free tier: $5/month platform credit (covers ~hundreds of LinkedIn scraper runs).
# Sign up at https://apify.com → Settings → Integrations → API tokens.
APIFY_TOKEN=
# Optional override; default is bebity~linkedin-jobs-scraper (free tier friendly,
# accepts {title, location, rows} input shape).
APIFY_LINKEDIN_ACTOR_ID=

# Where the cv-builder project lives — used by job_hunter to drop per-job folders
# (jobs/<slug>/jd.md + jobs/<slug>/tailored-cv.md). Default is the operator's
# laptop path; override if you ever move the project.
# CV_BUILDER_DIR=/Users/EmkayJami/Desktop/claude projects/cv builder

# Gold & Silver Rates (gold_rates agent) — manikumarjami.com/gold-rates
#
# Public Gist ID storing gold_rates_latest.json + gold_rates_history.json,
# written daily by the Vercel Cron (api/gold-rates-cron.js). Public, so no
# token is needed to read it, but GITHUB_TOKEN above raises the rate limit.
GOLD_RATES_GIST=

# Brevo — email signups + >5% move alerts for the gold-rates page.
# Sign up at https://app.brevo.com → SMTP & API → API Keys.
# BREVO_GOLD_LIST_ID is the numeric ID of the "Gold & Silver Alerts" contact
# list (Brevo dashboard → Contacts → Lists → click the list → ID in the URL).
# Both optional — the gold_rates dashboard view just shows "—" for subscriber
# count if unset, and the cron skips alert sends.
BREVO_API_KEY=
BREVO_GOLD_LIST_ID=
