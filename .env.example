# ─────────────────────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic API key — OPTIONAL if running agents through Claude Code CLI.
# Required for unattended cron/daemon runs.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

FLEET_DB_PATH=./data/status.db
OUTPUTS_DIR=./outputs
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# ─────────────────────────────────────────────────────────────────────────────
# Dashboard authentication
# ─────────────────────────────────────────────────────────────────────────────
# Default (both blank): open dashboard, no login — safe when bound to 127.0.0.1.
# Set both to require HTTP Basic Auth if you expose the dashboard publicly.
# Generate a strong password: openssl rand -base64 32
INDRA_DASHBOARD_USER=
INDRA_DASHBOARD_PASSWORD=

# Your site's base URL — used for CORS + digital_delivery download links
SITE_BASE_URL=https://yoursite.com
SITE_ORIGIN=https://yoursite.com

# ─────────────────────────────────────────────────────────────────────────────
# Langfuse — optional prompt management + tracing
# ─────────────────────────────────────────────────────────────────────────────
# If unset, agents fall back to hardcoded prompts and skip tracing.
# Sign up free at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─────────────────────────────────────────────────────────────────────────────
# n8n Cloud — IG auto-responder workflow
# ─────────────────────────────────────────────────────────────────────────────
# Your n8n instance base URL (e.g. https://yourname.app.n8n.cloud/api/v1)
N8N_API_BASE_URL=https://app.n8n.cloud/api/v1
N8N_API_KEY=
N8N_SEND_WEBHOOK_URL=

# Shared HMAC secret between Indra ↔ n8n (must match n8n env vars)
# Generate: openssl rand -hex 32
INDRA_N8N_SHARED_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Meta / Instagram — IG comment + DM responder
# ─────────────────────────────────────────────────────────────────────────────
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# GitHub
# ─────────────────────────────────────────────────────────────────────────────
# Fine-Grained PAT — Contents: Read-only on your repos is sufficient for most uses.
# Required for daily-brief archives, gold-rates Gist reads, delivery queue Gist.
GITHUB_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Resend — transactional email (free tier: 3K emails / month)
# ─────────────────────────────────────────────────────────────────────────────
# Sign up at https://resend.com → API Keys. NEVER use for cold email (AUP ban).
RESEND_API_KEY=
RESEND_FROM_EMAIL=You <hello@yoursite.com>

# ─────────────────────────────────────────────────────────────────────────────
# digital_delivery agent — deliver any digital product via signed download links
# ─────────────────────────────────────────────────────────────────────────────
PRODUCT_NAME=Your Digital Product
PRODUCT_SLUG=product
PRODUCT_TAGLINE=The resource you requested
PRODUCT_DESCRIPTION=Click the button below to download your copy.
DELIVERY_SUBJECT=Your download is ready ↓
DELIVERY_GATE_PATH=/api/download
TOKEN_TTL_HOURS=48

# GitHub Gist for the retry queue (written by your server when Resend rate-limits)
DELIVERY_QUEUE_GIST=
DELIVERY_QUEUE_FILE=delivery_pending.json
DELIVERY_GATE_URL=https://yoursite.com/api/download-gate
DELIVERY_SITE_ORIGIN=https://yoursite.com

# Comma-separated test emails to exclude from delivery stats
DELIVERY_TEST_EMAILS=ratelimit_test_qa@example.com

# HMAC signing key — must match the key on your server-side gate endpoint
# Generate: openssl rand -hex 32
ASSESS_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Apify — LinkedIn / Wellfound jobs scraper (job_hunter + startup_lookup agents)
# ─────────────────────────────────────────────────────────────────────────────
# Free tier: $5/month platform credit. Sign up at https://apify.com
APIFY_TOKEN=
APIFY_LINKEDIN_ACTOR_ID=
APIFY_WELLFOUND_ACTOR_ID=

# Path to your CV builder project (job_hunter drops tailored CVs here)
CV_BUILDER_DIR=./cv-builder

# ─────────────────────────────────────────────────────────────────────────────
# gold_rates agent — commodity price tracker
# ─────────────────────────────────────────────────────────────────────────────
# Public GitHub Gist ID storing gold_rates_latest.json + gold_rates_history.json
GOLD_RATES_GIST=

# Brevo — email list for >5% move alerts
# Sign up at https://app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=
BREVO_GOLD_LIST_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Labs / assessment email view (dashboard only — not required for agents)
# ─────────────────────────────────────────────────────────────────────────────
# Your verified Resend sending domain (e.g. labs.yoursite.com)
LABS_DOMAIN=
